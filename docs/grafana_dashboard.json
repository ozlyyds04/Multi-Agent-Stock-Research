{
  "title": "多智能体股票研究 · 可观测性",
  "uid": "multiagent-stock-research",
  "description": "任务状态、LLM 成本/耗时/token、节点耗时、数据源错误、严格模式中止",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "tags": ["multiagent", "stock", "llm", "observability"],
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "label": "数据源",
        "current": {},
        "multi": false,
        "options": [],
        "regex": ""
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "运行任务数（按状态）",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum by(status) (research_runs_total)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "short"},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "成功率",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 9},
      "targets": [
        {
          "expr": "100 * sum(research_runs_total{status=\"success\"}) / clamp_min(sum(research_runs_total), 1)",
          "legendFormat": "成功率",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "percent", "decimals": 1},
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["mean"], "fields": ""},
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "进行中任务数",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 9},
      "targets": [
        {
          "expr": "research_runs_in_progress",
          "legendFormat": "进行中",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "requests",
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": ""}
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "节点耗时 P95",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 18},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, node) (rate(research_node_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "s"},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "LLM 累计成本（按模型）",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 27},
      "targets": [
        {
          "expr": "sum by(model) (research_llm_cost_total)",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "currencyUSD"},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "LLM token 速率（输入/输出）",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 27},
      "targets": [
        {
          "expr": "sum by(type) (rate(research_llm_tokens_total[$__rate_interval]))",
          "legendFormat": "{{type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "short"},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "数据源错误",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 36},
      "targets": [
        {
          "expr": "sum by(source) (increase(research_data_source_errors_total[$__range]))",
          "legendFormat": "{{source}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "short"},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "严格模式中止",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 36},
      "targets": [
        {
          "expr": "sum_increase(research_strict_aborts_total[$__range])",
          "legendFormat": "中止",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "short", "decimals": 0},
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": ""},
        "colorMode": "value",
        "graphMode": "none"
      }
    }
  ]
}
