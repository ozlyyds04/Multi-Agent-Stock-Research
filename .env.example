# Optional. No paid APIs used by default.
ALPHA_VANTAGE_API_KEY=""   # Alpha Vantage free key (25 requests/day)

DEEPSEEK_API_KEY=""        # DeepSeek API key (used when provider=deepseek)
DEEPSEEK_BASE_URL=""       # Optional DeepSeek-compatible endpoint base URL
LLM_MODEL="deepseek-v4-flash-vision-exp"  # Optional: override the model used by the agents (else settings.yaml)
API_KEY=""                 # Optional: set to require X-API-Key on write endpoints (empty = no auth, for local dev)
                           # NOTE: the frontend VITE_API_KEY is baked into the client bundle and is
                           # NOT a security boundary — use a reverse proxy / gateway for real auth.

OPENAI_API_KEY=""          # OpenAI API key (used when provider=openai)
OPENAI_BASE_URL=""         # Optional OpenAI-compatible endpoint base URL

HUMAN_IN_LOOP=false        # 'true' to pause before publishing
LOG_LEVEL=INFO

DATABASE_URL=""            # PostgreSQL checkpointer for HITL approval edge. Leave empty to fall back to in-memory.
CHECKPOINTER=""            # 'memory' forces the in-process checkpointer even when DATABASE_URL is set
                           # (runs registry then also goes in-memory). Leave empty for auto.

ARTIFACTS_DIR="artifacts"  # Where reports/PDF/charts are written. The API always writes under this dir
                           # regardless of any client-supplied outdir.

# Redis backend (event bus / fundamentals cache / short-term memory).
# Leave REDIS_URL empty to fall back to in-memory implementations (zero dependency).
REDIS_URL=""               # e.g. redis://127.0.0.1:6379/0 — REQUIRED when CELERY_ENABLED=true
REDIS=""                   # set to 'none' to force in-memory even when REDIS_URL is set

# Rate limiter per upstream source (requests per second / per day).
# Defaults mirror the free-tier quotas; raise these if you use paid keys.
RL_ALPHA_VANTAGE_QPS=1
RL_ALPHA_VANTAGE_DAILY=25
RL_EASTMONEY_QPS=5
RL_EASTMONEY_DAILY=5000
RL_NEWS_QPS=2
RL_NEWS_DAILY=2000

# Long-term memory (vector store). 'memory' = in-process fallback (zero dependency);
# 'postgres' requires DATABASE_URL + the pgvector extension.
MEMORY_BACKEND=memory
# Embedder for long-term memory vectors. Uses OPENAI_API_KEY (text-embedding-3-small)
# when set, otherwise falls back to a deterministic offline hash embedder.
# Memory auto-compaction: beyond MEMORY_MAX_ENTRIES per symbol, the old entries are
# summarized (LLM) if a provider key is available, else pruned by importance.
MEMORY_MAX_ENTRIES=50

# Skip precheck (symbol validation) when the quote source is rate-limited.
SKIP_PRECHECK_ON_RATELIMIT=true
# Local disk cache TTL (hours) for fetched price series.
PRICE_CACHE_TTL_HOURS=6

# Observability
LOG_FORMAT=json               # 'json' -> logs/app.log is structured JSON (ELK/Loki). 'text' for plain.
# Optional per-model LLM cost override (USD per million tokens), e.g. PRICING_DEEPSEEKV4FLASH_IN
# PRICING_DEEPSEEKV4FLASH_IN=0.28
# PRICING_DEEPSEEKV4FLASH_OUT=1.10

# Celery / Redis task queue (priority + retry + dead-letter).
# Set CELERY_ENABLED=true to queue work to a Celery worker instead of the in-process thread pool.
# Requires REDIS_URL + DATABASE_URL (and a non-memory checkpointer) — otherwise the API
# automatically falls back to in-process execution.
CELERY_ENABLED=false
