# Optional. No paid APIs used by default.
ALPHA_VANTAGE_API_KEY=""   # Alpha Vantage free key (25 requests/day)

DEEPSEEK_API_KEY=""        # DeepSeek API key (used when provider=deepseek)
DEEPSEEK_BASE_URL=""       # Optional DeepSeek-compatible endpoint base URL

OPENAI_API_KEY=""          # OpenAI API key (used when provider=openai)
OPENAI_BASE_URL=""         # Optional OpenAI-compatible endpoint base URL

NEWS_SOURCES="yahoo,benzinga"  # Internal selector for RSS tools
HUMAN_IN_LOOP=false        # 'true' to pause before publishing
LOG_LEVEL=INFO

DATABASE_URL=""            # PostgreSQL checkpointer for HITL approval edge. Leave empty to fall back to in-memory.

